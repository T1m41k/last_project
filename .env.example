# Рядок підключення до Neon (TLS-параметр sslmode=require зберігається).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Токен бота від @BotFather.
BOT_TOKEN=123456789:replace-with-token-from-botfather
# Telegram user id адміністраторів через кому (визначається лише тут, на сервері).
ADMIN_PLATFORM_IDS=123456789
# Токен для GET /api/v1/admin/stats (заголовок Authorization: Bearer ...).
ADMIN_API_TOKEN=replace-with-long-random-string
# false — не запускати long polling (корисно для тестів і міграцій).
BOT_POLLING_ENABLED=true
LOG_LEVEL=INFO
